      ],
      "answer": 1,
      "explanation": "Approaching the deadline… = As we approached…"
    },
    {
      "id": "F-010-Q08",
      "skill": "passive-participle",
      "question": "\"Documents ___ last week are ready.\"",
      "choices": [
        "signing",
