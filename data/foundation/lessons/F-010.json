      "skill": "emotion",
      "question": "\"I am ___ in data privacy.\"",
      "choices": [
        "interesting",
        "interested",
        "interest",
        "interests"
      ],
      "answer": 1,
      "explanation": "사람이 ‘관심 있다’는 interested입니다."
    },
    {
      "id": "F-010-Q04",
      "skill": "emotion-trap",
      "question": "\"The lecture was ___ .\"",
      "choices": [
        "bored",
        "boring",
