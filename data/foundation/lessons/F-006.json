{
  "id": "F-006",
  "order": 6,
  "title": "조동사",
  "category": "grammar",
  "estimatedMinutes": 12,
  "skills": [
    "modals",
    "ability-permission",
    "deduction-obligation"
  ],
  "objectives": [
    "가능·허가·의무·추측 조동사의 기본 의미를 구분한다",
    "must / have to / should의 뉘앙스 차이를 익힌다",
    "조동사 + 원형동사 형태를 정확히 고른다"
  ],
  "concept": {
    "summary": "조동사는 본동사 앞에 붙어 가능·의무·허가·추측 등의 태도를 더합니다. 형태는 조동사 + 동사원형이 기본이며, 의미 차이를 모르면 비슷한 선택지가 전부 맞아 보입니다.",
    "points": [
      "can/could: 능력·가능·허가 / may/might: 허가·약한 추측",
      "must: 강한 의무·강한 추측 / have to: 외부 의무",
      "should/ought to: 권고·당연",
      "will/would: 미래·의지·정중한 요청"
    ]
  },
  "examples": [
    {
      "en": "You must wear a badge in the lab.",
      "ko": "실험실에서는 배지를 반드시 착용해야 한다.",
      "structure": "must + 원형"
    },
    {
      "en": "She can handle complex data.",
      "ko": "그녀는 복잡한 데이터를 다룰 수 있다.",
      "structure": "can = 능력"
    },
    {
      "en": "He might be in a meeting.",
      "ko": "그는 회의 중일지도 모른다.",
      "structure": "might = 추측"
    }
  ],
