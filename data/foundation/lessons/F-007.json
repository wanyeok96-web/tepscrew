      ],
      "answer": 1,
      "explanation": "행위자보다 대상·결과가 중요하면 수동이 흔합니다."
    },
    {
      "id": "F-007-Q09",
      "skill": "get-passive",
      "question": "구어체에서 be 대신 자주 쓰이는 수동 표현은?",
      "choices": [
        "do + p.p.",
        "get + p.p.",
        "make + 원형만",
        "have + 원형만"
      ],
      "answer": 1,
      "explanation": "get paid, get damaged처럼 get + p.p. 수동이 있습니다."
    },
    {
      "id": "F-007-Q10",
      "skill": "error",
      "question": "틀린 문장은?",
      "choices": [
        "The policy was revised.",
        "The policy has been revised.",
        "The policy was revise.",
        "The policy is being revised."
      ],
      "answer": 2,
      "explanation": "수동에는 과거분사가 필요합니다. revise가 아니라 revised입니다."
