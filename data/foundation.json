{
  "version": 1,
  "demo": true,
  "lessons": [
    {
      "id": "F-001",
      "order": 1,
      "title": "영어 문장의 뼈대",
      "category": "sentence",
      "estimatedMinutes": 12,
      "status": "recommended",
      "objectives": [
        "영어 문장의 기본 구조를 이해한다",
        "주어·동사·목적어·보어의 역할을 구분한다",
        "간단한 문장을 구조적으로 분석한다"
      ],
      "concept": {
        "summary": "영어 문장은 주어(Subject)와 동사(Verb)를 중심으로 구성됩니다. 여기에 목적어(Object)나 보어(Complement)가 더해지며 의미가 완성됩니다.",
        "points": [
          "S + V : 주어가 무엇을 한다",
          "S + V + O : 주어가 목적어에게 행위한다",
          "S + V + C : 주어의 상태를 보어로 설명한다",
          "S + V + O + C / S + V + IO + DO : 문장이 확장된다"
        ]
      },
      "examples": [
        {
          "en": "She studies.",
          "ko": "그녀는 공부한다.",
          "structure": "S + V"
        },
        {
          "en": "He reads a book.",
          "ko": "그는 책을 읽는다.",
          "structure": "S + V + O"
        },
        {
          "en": "The soup tastes delicious.",
          "ko": "그 수프는 맛있다.",
          "structure": "S + V + C"
        }
      ],
      "checks": [
        {
          "id": "F-001-Q1",
          "question": "\"Tom opened the door.\"의 문장 구조는?",
          "choices": ["S + V", "S + V + O", "S + V + C", "S + V + IO + DO"],
          "answer": 1,
          "explanation": "Tom(주어)이 opened(동사)로 the door(목적어)를 열었습니다. S + V + O 구조입니다."
        },
        {
          "id": "F-001-Q2",
          "question": "다음 중 보어(Complement)가 있는 문장은?",
          "choices": [
            "I bought a ticket.",
            "She became a teacher.",
            "They watched a movie.",
            "We closed the window."
          ],
          "answer": 1,
          "explanation": "became 다음에 오는 a teacher는 주어 She의 상태를 설명하는 보어입니다."
        },
        {
          "id": "F-001-Q3",
          "question": "영어 문장에서 가장 중심이 되는 두 요소는?",
          "choices": ["형용사와 부사", "전치사와 접속사", "주어와 동사", "목적어와 보어"],
          "answer": 2,
          "explanation": "주어와 동사는 영어 문장의 뼈대입니다. 나머지 요소는 이 위에 확장됩니다."
        }
      ]
    },
    {
      "id": "F-002",
      "order": 2,
      "title": "품사",
      "category": "sentence",
      "estimatedMinutes": 10,
      "status": "not_started",
      "objectives": [
        "주요 품사의 역할을 이해한다",
        "문장 속에서 품사를 식별한다"
      ],
      "concept": {
        "summary": "품사는 단어가 문장에서 하는 역할입니다. 명사, 동사, 형용사, 부사, 전치사, 접속사 등을 구분할 수 있어야 합니다.",
        "points": [
          "명사: 사람·사물·개념의 이름",
          "동사: 동작이나 상태",
          "형용사: 명사를 수식",
          "부사: 동사·형용사·다른 부사를 수식"
        ]
      },
      "examples": [
        {
          "en": "A careful student reads slowly.",
          "ko": "신중한 학생은 천천히 읽는다.",
          "structure": "형용사 careful / 부사 slowly"
        }
      ],
      "checks": []
    },
    {
